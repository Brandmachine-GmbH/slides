{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@engine/*": ["./node_modules/@brandmachine/slides/src/engine/*"]
    }
  },
  "include": ["decks", "mockups", ".slides/names.d.ts", "node_modules/@brandmachine/slides/src/vite-env.d.ts"]
}
