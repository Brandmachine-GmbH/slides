{
  "name": "@brandmachine/slides",
  "version": "0.1.0",
  "description": "A slideshow engine for client decks: each deck is data in decks/<name>/, built to its own bundle and served at a secret per-deck URL.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brandmachine-GmbH/slides.git"
  },
  "homepage": "https://github.com/Brandmachine-GmbH/slides#readme",
  "keywords": [
    "slides",
    "presentation",
    "deck",
    "vite",
    "react"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "slides": "bin/slides.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/engine/index.ts",
      "default": "./src/engine/index.ts"
    },
    "./netlify": "./netlify/admin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "build.mjs",
    "vite.config.ts",
    "index.html",
    "src/",
    "hub/",
    "template/decks/",
    "!template/decks/*/*.pdf",
    "template/netlify/edge-functions/admin.ts",
    "template/brand.json",
    "template/gitignore",
    "template/netlify.toml",
    "template/theme.css",
    "template/tsconfig.json",
    "netlify/admin.js",
    "scripts/check-leaks.mjs",
    "scripts/export-pdf.mjs",
    "scripts/motion.mjs",
    "scripts/serve.mjs",
    "scripts/verify-deploy.mjs",
    "THIRD-PARTY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "esbuild src/netlify/admin.ts --format=esm --target=es2022 --log-level=warning --outfile=netlify/admin.js",
    "check": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "exifr": "^7.1.3",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
