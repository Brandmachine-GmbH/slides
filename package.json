{
  "name": "slides",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "description": "A slideshow engine for client decks: each deck is data in decks/<name>/, built to its own bundle and served at a secret per-deck URL.",
  "scripts": {
    "dev": "vite",
    "build": "node build.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "verify": "node scripts/verify-deploy.mjs",
    "serve": "npm run build && node scripts/serve.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "exifr": "^7.1.3",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
