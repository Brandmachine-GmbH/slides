node_modules/
dist/
site.zip
.DS_Store
*.log

# Exported deck PDFs are build artifacts (make pdf <deck>)
decks/*/*.pdf

# The build writes three modules here. Between them they hold every deck in full, every slug
# and every passcode, which makes them the most sensitive files a checkout can contain and the
# worst thing to have sitting in a working tree as ordinary-looking source. They are output, so
# a checkout that has never built should not have them at all.
netlify/edge-functions/lib/*.js

# Netlify CLI local link state
.netlify/

# Local secrets for `netlify dev` (real values live in Netlify env vars)
.env

# Netlify edge-function (Deno) lockfile, regenerated by `netlify dev`
deno.lock
